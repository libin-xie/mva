* GET.CUST - read a customer and check credit status
* Called from order entry screens.
*-------------------------------------------
SUBROUTINE GET.CUST(CUST.ID, REC,
     ERR)
$INCLUDE BP COMMON.EQUATES
COMMON /GLOBALS/ G.USER, G.DATE
EQU AM TO CHAR(254), VM TO CHAR(253)
EQUATE MAX.TRIES TO 3
   ERR = ''
   OPEN 'CUSTOMER' TO F.CUST ELSE
      ERR = 'Cannot open CUSTOMER'
      RETURN
   END
   OPEN 'DICT', 'CUSTOMER' TO D.CUST ELSE RETURN
   OPEN '', 'AUDIT.LOG' TO F.AUDIT ELSE ERR = 'no audit' ; RETURN
   READU REC FROM F.CUST, CUST.ID ELSE
      ERR = 'Not found' ; GOSUB LOG.IT
      RETURN
   END
   CRT "GOSUB FAKE is just text" ;* GOSUB ALSO.FAKE in a comment
   ON MODE GOSUB CHECK.A, CHECK.B
   GOSUB VALIDATE
   GOSUB NO.SUCH.LABEL
   I = 0
10 I += 1
   IF I < MAX.TRIES THEN GOTO 10
   BEGIN CASE
      CASE REC<1> = 'X'
         GOSUB WRITE.AUDIT
      CASE 1
         NULL
   END CASE
   FOR J = 1 TO 3
      CALL LOG.ERROR(J)
   NEXT J
   LOOP
      READNEXT ID ELSE EXIT
   REPEAT
   CALL @DYN.ROUTINE
   EXECUTE "SELECT CUSTOMER WITH STATUS = 'A'"
   WRITE REC ON F.CUST, CUST.ID
   RETURN
*
VALIDATE:
   IF REC = '' THEN RETURN
   GOSUB CHECK.CREDIT
   RETURN
   GOSUB NEVER.RUNS
*
CHECK.CREDIT:
   GOSUB VALIDATE
   RETURN
*
CHECK.A:
   GOSUB WRITE.AUDIT
CHECK.B:
   RETURN
*
WRITE.AUDIT:
   WRITE REC ON F.AUDIT, CUST.ID
   DELETE F.CUST, 'TEMP'
   RETURN
*
NEVER.RUNS:
   RETURN
*
ORPHAN:
   CRT 'nobody calls me'
   RETURN
*
LOG.IT:
   RETURN
LOG.IT:
   RETURN
END
